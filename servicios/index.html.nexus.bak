<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Servicios de CORDEXSERVER: Servidores VPS, Desarrollo Web, Seguridad y Optimizacion.">
    <title>Servicios - CORDEXSERVER</title>
    <link rel="icon" href="../img/I1.jpeg">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Syne para títulos e Inter para cuerpo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- GSAP & ScrollTrigger -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <style>
        /* Base y Reseteo (Awwwards) */
        :root {
            --dark-bg: #050505;
            --accent: #e2e8f0;
        }
        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            cursor: none;
        }
        h1, h2, h3, .font-syne {
            font-family: 'Syne', sans-serif;
        }
        ::-webkit-scrollbar { width: 0px; background: transparent; }

        /* Custom Cursor */
        .custom-cursor {
            position: fixed;
            top: 0; left: 0;
            width: 12px; height: 12px;
            background: white;
            border-radius: 50%;
            pointer-events: none;
            z-index: 9999;
            transform: translate(-50%, -50%);
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), height 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s;
            mix-blend-mode: difference;
        }
        .custom-cursor.hover {
            width: 60px; height: 60px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255,255,255,0.5);
            backdrop-filter: blur(4px);
            mix-blend-mode: normal;
        }

        /* Ruido de fondo cinemático */
        .noise-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            opacity: 0.04;
            z-index: 50; pointer-events: none;
        }

        /* Orbes Animados de Fondo */
        .orb {
            position: fixed; border-radius: 50%;
            filter: blur(120px); z-index: 0;
            animation: float 20s infinite ease-in-out alternate;
        }
        .orb-1 { top: -10%; left: -10%; width: 50vw; height: 50vw; background: rgba(56, 189, 248, 0.15); }
        .orb-2 { bottom: -20%; right: -10%; width: 60vw; height: 60vw; background: rgba(168, 85, 247, 0.15); animation-delay: -5s; }

        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(5%, 10%) scale(1.1); }
            100% { transform: translate(-5%, -5%) scale(0.9); }
        }

        /* Header / Navegación (Awwwards + CORDEX) */
        .header-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: none;
            border: none;
            color: inherit;
            font-family: 'Syne', sans-serif;
            cursor: none;
            padding: 0;
        }
        .header-btn img {
            height: 46px;
            width: auto;
            border-radius: 10px;
            box-shadow: 0 0 12px rgba(255, 30, 30, 0.35);
        }
        .header-btn .logo-text {
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: -0.02em;
        }
        .nav-menu-text {
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            background: none;
            border: none;
            color: inherit;
            cursor: none;
        }

        /* Sidebar (adaptado de cordexSever, tema oscuro) */
        .no-scroll { overflow: hidden; }
        .overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
        }
        .overlay--show { opacity: 1; visibility: visible; }
        .sidebar {
            position: fixed;
            top: 0; left: 0;
            z-index: 300;
            display: flex;
            flex-direction: column;
            width: min(320px, 85%);
            height: 100%;
            background: #0a0a0a;
            border-right: 1px solid rgba(255,255,255,0.1);
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);
            transform: translateX(-100%);
            visibility: hidden;
            transition: transform 0.3s ease, visibility 0.3s;
        }
        .sidebar--open { transform: translateX(0); visibility: visible; }
        .sidebar__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar__brand {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
        }
        .sidebar__brand img {
            height: 46px; width: auto; border-radius: 10px;
        }
        .sidebar__title {
            font-family: 'Syne', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            color: #ffffff;
        }
        .sidebar__close {
            background: none; border: none;
            font-size: 2rem; line-height: 1;
            color: rgba(255,255,255,0.6);
            cursor: pointer;
        }
        .sidebar__close:hover { color: #ffffff; }
        .sidebar__nav {
            display: flex; flex-direction: column;
            padding: 1rem 0.8rem;
            gap: 0.2rem;
            flex: 1;
        }
        .sidebar__nav a {
            padding: 0.85rem 1rem;
            border-radius: 8px;
            font-weight: 500;
            color: rgba(255,255,255,0.85);
            transition: background 0.2s, color 0.2s;
        }
        .sidebar__nav a:hover {
            background: rgba(255,255,255,0.05);
            color: #ffffff;
        }
        .sidebar__footer {
            padding: 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.08);
            text-align: center;
        }
        .sidebar__footer p {
            margin-bottom: 0.8rem;
            color: rgba(255,255,255,0.6);
        }
        .btn-small {
            display: inline-block;
            padding: 0.6rem 1.3rem;
            background: #ffffff;
            color: #000000;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: transform 0.2s;
        }
        .btn-small:hover { transform: translateY(-2px); }

        /* Hero: Cristal Cortado */
        .hero-pin-wrapper { height: 100vh; overflow: hidden; position: relative; z-index: 10; }
        .hero-left {
            position: absolute; top: 0; left: 0;
            width: 55%; height: 100%;
            background: var(--dark-bg);
            clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%);
            display: flex; flex-direction: column; justify-content: center;
            padding-left: 8vw; z-index: 2;
            box-shadow: 20px 0 50px rgba(0,0,0,0.5);
        }
        .hero-right {
            position: absolute; top: 0; right: 0;
            width: 55%; height: 100%;
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border-left: 1px solid rgba(255, 255, 255, 0.1);
            clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
            display: flex; align-items: center; justify-content: center;
            z-index: 1; overflow: hidden;
        }
        .abstract-shape {
            width: 400px; height: 400px;
            background: linear-gradient(135deg, #38bdf8, #a855f7);
            border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
            filter: blur(40px);
            animation: morph 8s ease-in-out infinite;
        }
        @keyframes morph {
            0%, 100% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; transform: rotate(0deg); }
            50% { border-radius: 70% 30% 50% 50% / 30% 30% 70% 70%; transform: rotate(180deg); }
        }

        .text-outline { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.4); }

        /* Paneles de Cristal (Secciones) */
        .glass-panel {
            background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 2rem;
            box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        }

        /* Marquee Ticker */
        .marquee-wrapper {
            position: relative; width: 100%; overflow: hidden;
            background: white; color: black;
            transform: rotate(-3deg); margin-top: -5vh; z-index: 20;
            padding: 2rem 0; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }
        .marquee-inner { display: flex; width: max-content; }
        .marquee-item {
            font-size: 4rem; font-family: 'Syne', sans-serif; font-weight: 800;
            padding: 0 2rem; text-transform: uppercase;
            white-space: nowrap;
        }

        /* Formulario (tema oscuro) */
        .form-dark { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
        .form-dark label { font-weight: 600; margin-top: 0.6rem; font-size: 0.95rem; }
        .form-dark input, .form-dark textarea {
            padding: 0.85rem 1rem;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 10px;
            background: rgba(255,255,255,0.04);
            color: #ffffff;
            font: inherit;
            width: 100%;
        }
        .form-dark input:focus, .form-dark textarea:focus {
            outline: none;
            border-color: rgba(255,255,255,0.5);
            box-shadow: 0 0 0 3px rgba(255,255,255,0.1);
        }
        .form-dark .btn-submit {
            margin-top: 1.2rem;
            align-self: flex-start;
            padding: 0.9rem 2rem;
            background: #ffffff;
            color: #000000;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            border-radius: 999px;
            border: none;
            cursor: none;
            transition: transform 0.2s;
        }
        .form-dark .btn-submit:hover { transform: scale(1.04); }

        /* Responsive */
        @media (max-width: 768px) {
            .hero-pin-wrapper { height: auto; min-height: 100vh; }
            .hero-left, .hero-right {
                position: relative;
                width: 100%;
                clip-path: none;
                border: none;
            }
            .hero-left { padding: 120px 1.5rem 3rem; }
            .hero-right { height: 45vh; border-top: 1px solid rgba(255,255,255,0.1); }
            .abstract-shape { width: 240px; height: 240px; }
            .marquee-item { font-size: 2.2rem; }
        }
        @media (hover: none) {
            body { cursor: auto; }
            .custom-cursor { display: none; }
            .header-btn, .nav-menu-text, .form-dark .btn-submit { cursor: pointer; }
        }
    </style>
</head>
<body>

    <!-- Custom Cursor -->
    <div class="custom-cursor" id="cursor"></div>
    <div class="noise-bg"></div>

    <!-- Background Orbs -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <!-- Navegación Minimalista -->
    <nav class="fixed top-0 left-0 w-full p-8 flex justify-between items-center z-50 mix-blend-difference pointer-events-none">
        <button class="header-btn pointer-events-auto cursor-hover" id="sidebarToggle" aria-label="Abrir barra lateral" aria-expanded="false" aria-controls="sidebar">
            <img src="../img/I1.jpeg" alt="Logo CORDEXSERVER" width="38" height="46">
            <span class="logo-text">CORDEXSERVER</span>
        </button>
        <button class="nav-menu-text pointer-events-auto cursor-hover" id="sidebarToggleMenu" aria-label="Abrir menú">Menú</button>
    </nav>

    <!-- Barra lateral -->
    <div class="overlay" id="overlay"></div>
    <aside class="sidebar" id="sidebar" aria-hidden="true">
        <div class="sidebar__header">
            <span class="sidebar__brand">
                <img src="../img/I1.jpeg" alt="Logo" width="38" height="46">
                <span class="sidebar__title">CORDEXSERVER</span>
            </span>
            <button class="sidebar__close" id="sidebarClose" aria-label="Cerrar barra lateral">&times;</button>
        </div>
        <nav class="sidebar__nav">
            <a href="../index.html">🏠 Inicio</a>
            <a href="index.html">🛠️ Servicios</a>
            <a href="streaming.html">📺 Streaming</a>
            <a href="../index.html#contacto">✉️ Contacto</a>
        </nav>
        <div class="sidebar__footer">
            <p>¿Necesitas ayuda?</p>
            <a href="../index.html#contacto" class="btn-small">Escríbenos</a>
        </div>
    </aside>

    <!-- MAIN SCROLL CONTAINER -->
    <main id="smooth-wrapper">
        <div id="smooth-content">

            <!-- HERO: Cristal Cortado -->
            <section class="hero-pin-wrapper" id="hero">

                <!-- Panel Izquierdo (Texto) -->
                <div class="hero-left">
                    <div class="overflow-hidden mb-2">
                        <h1 class="font-syne text-5xl md:text-8xl lg:text-[8rem] font-bold leading-[0.85] tracking-tighter hero-title">
                            SERVICIOS
                        </h1>
                    </div>
                    <div class="overflow-hidden">
                        <h1 class="font-syne text-5xl md:text-8xl lg:text-[8rem] font-bold leading-[0.85] tracking-tighter text-outline hero-title">
                            TECNICOS
                        </h1>
                    </div>
                    <div class="mt-8 overflow-hidden max-w-md">
                        <p class="text-gray-400 text-lg md:text-xl font-light leading-relaxed hero-desc">
                            Soluciones de infraestructura, hosting y desarrollo a la medida de tu proyecto. Especializados en alto rendimiento.
                        </p>
                    </div>
                    <div class="mt-8 flex flex-wrap gap-4 hero-desc">
                        <a href="index.html" class="px-8 py-4 bg-white text-black font-bold rounded-full hover:scale-105 transition-transform cursor-hover font-syne">Ver servicios</a>
                        <a href="../index.html#contacto" class="px-8 py-4 border border-white/40 hover:bg-white/10 transition-colors cursor-hover font-syne rounded-full">Contáctanos</a>
                    </div>
                </div>

                <!-- Panel Derecho (Cristal Borroso) -->
                <div class="hero-right">
                    <div class="abstract-shape"></div>
                </div>

            </section>

            <!-- MARQUEE TICKER -->
            <section class="marquee-wrapper">
                <div class="marquee-inner" id="marquee">
                    <div class="marquee-item">VPS • Desarrollo Web • Seguridad • Optimizacion •</div>
                    <div class="marquee-item">VPS • Desarrollo Web • Seguridad • Optimizacion •</div>
                </div>
            </section>

            <!-- SECCIONES DE CRISTALES (ASIMÉTRICAS) -->
            <section class="relative z-10 py-32 px-6 lg:px-12 max-w-[100vw] overflow-hidden" id="content-sections">

                <!-- Cristal 1: Alineado a la derecha -->
                <div class="glass-panel w-full md:w-3/4 lg:w-2/3 ml-auto p-10 md:p-16 mb-32 parallax-card">
                    <div class="flex flex-col md:flex-row gap-10 items-center">
                        <div class="flex-1">
                            <h2 class="font-syne text-4xl md:text-6xl font-bold mb-6">Servidores <br><span class="text-outline">Dedicados.</span></h2>
                            <p class="text-gray-300 text-lg font-light leading-relaxed mb-8">
                                Configuración, despliegue y mantenimiento de servidores virtuales y dedicados de alto rendimiento sobre Linux.
                            </p>
                            <a href="index.html" class="inline-block border-b border-white pb-1 font-medium hover:text-gray-300 transition-colors cursor-hover">Ver servicios</a>
                        </div>
                        <div class="w-full md:w-1/3 aspect-square rounded-2xl overflow-hidden relative">
                            <div class="absolute inset-0 bg-gradient-to-tr from-sky-500 to-purple-600 mix-blend-overlay"></div>
                            <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=1000&auto=format&fit=crop" class="w-full h-full object-cover grayscale" alt="Servidores">
                        </div>
                    </div>
                </div>

                <!-- Cristal 2: Alineado a la izquierda -->
                <div class="glass-panel w-full md:w-3/4 lg:w-2/3 mr-auto p-10 md:p-16 mb-32 parallax-card">
                    <div class="flex flex-col md:flex-row-reverse gap-10 items-center">
                        <div class="flex-1">
                            <h2 class="font-syne text-4xl md:text-6xl font-bold mb-6">Desarrollo <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">Web.</span></h2>
                            <p class="text-gray-300 text-lg font-light leading-relaxed mb-8">
                                Aplicaciones web responsivas, landings y APIs REST escalables con HTML5, CSS3, JS y backend.
                            </p>
                            <a href="streaming.html" class="inline-block border-b border-white pb-1 font-medium hover:text-gray-300 transition-colors cursor-hover">Ver Streaming</a>
                        </div>
                        <div class="w-full md:w-1/3 aspect-square rounded-2xl overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=1000&auto=format&fit=crop" class="w-full h-full object-cover grayscale opacity-80" alt="Streaming">
                        </div>
                    </div>
                </div>

                <!-- Cristal 3: Centrado y ancho -->
                <div class="glass-panel w-full lg:w-5/6 mx-auto p-12 md:p-24 text-center parallax-card relative overflow-hidden">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-purple-500/30 rounded-full blur-[80px] pointer-events-none"></div>
                    <h2 class="font-syne text-5xl md:text-7xl font-bold mb-8 relative z-10">Nuestros <br>Servicios.</h2>
                    <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto relative z-10">Soluciones completas: VPS, Desarrollo, Seguridad y Optimización. Cotiza tu proyecto hoy.</p>
                    <a href="#contacto" class="relative z-10 inline-block px-10 py-5 bg-white text-black font-syne font-bold text-xl rounded-full hover:scale-105 transition-transform duration-300 cursor-hover shadow-[0_0_40px_rgba(255,255,255,0.2)]">
                        Contactar Ahora
                    </a>
                </div>

            </section>

            <!-- SERVICIOS RÁPIDOS + CONTACTO -->
            <section class="relative z-10 px-6 lg:px-12 pb-32" id="contacto">
                <div class="glass-panel w-full max-w-3xl mx-auto p-10 md:p-16">
                    <div class="text-center mb-10">
                        <h2 class="font-syne text-4xl md:text-5xl font-bold mb-4">Soporte</h2>
                        <p class="text-gray-400">Escríbenos y te responderemos pronto</p>
                    </div>
                    <form class="form-dark" action="#" method="post">
                        <label for="nombre">Nombre</label>
                        <input type="text" id="nombre" name="nombre" required>

                        <label for="email">Correo electrónico</label>
                        <input type="email" id="email" name="email" required>

                        <label for="mensaje">Mensaje</label>
                        <textarea id="mensaje" name="mensaje" rows="5" required></textarea>

                        <button type="submit" class="btn-submit cursor-hover">Enviar mensaje</button>
                    </form>
                </div>
            </section>

            <!-- Footer Minimalista -->
            <footer class="py-10 border-t border-white/10 text-center relative z-10">
                <p class="text-sm font-medium tracking-widest uppercase text-gray-500">© 2026 CORDEXSERVER. Awwwards Level Infrastructure.</p>
            </footer>

        </div>
    </main>

    <!-- Lógica de Sidebar (mismo que js/script.js) -->
    <script src="../js/script.js"></script>

    <!-- GSAP & Lógica de Interacción (Awwwards) -->
    <script>
        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("DOMContentLoaded", () => {
            const cursor = document.getElementById('cursor');
            const hoverTargets = document.querySelectorAll('.cursor-hover, a, button');

            const xTo = gsap.quickTo(cursor, "x", {duration: 0.2, ease: "power3"}),
                  yTo = gsap.quickTo(cursor, "y", {duration: 0.2, ease: "power3"});

            window.addEventListener("mousemove", e => {
                xTo(e.clientX);
                yTo(e.clientY);
            });

            hoverTargets.forEach(target => {
                target.addEventListener('mouseenter', () => cursor.classList.add('hover'));
                target.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
            });

            // Animación inicial
            const tlLoad = gsap.timeline();
            tlLoad.fromTo(".hero-title",
                { y: "100%", opacity: 0 },
                { y: "0%", opacity: 1, duration: 1.2, stagger: 0.2, ease: "power4.out", delay: 0.2 }
            )
            .fromTo(".hero-desc",
                { opacity: 0, y: 20 },
                { opacity: 1, y: 0, duration: 1, ease: "power2.out", stagger: 0.15 },
                "-=0.5"
            )
            .fromTo(".abstract-shape",
                { scale: 0, opacity: 0 },
                { scale: 1, opacity: 1, duration: 2, ease: "elastic.out(1, 0.5)" },
                "-=1.5"
            );

            // Hero: el cristal se rompe al scroll (solo desktop)
            if (window.innerWidth > 768) {
                const heroTimeline = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#hero",
                        start: "top top",
                        end: "+=150%",
                        pin: true,
                        scrub: 1
                    }
                });
                heroTimeline.to(".hero-left", { xPercent: -100, ease: "power1.inOut" }, 0)
                            .to(".hero-right", { xPercent: 100, ease: "power1.inOut" }, 0);
            }

            // Marquee infinito
            gsap.to(".marquee-inner", {
                xPercent: -50,
                ease: "none",
                duration: 15,
                repeat: -1
            });

            gsap.to(".marquee-wrapper", {
                scrollTrigger: {
                    trigger: ".marquee-wrapper",
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1
                },
                rotation: -1,
                y: -50
            });

            // Paneles parallax
            const panels = gsap.utils.toArray('.parallax-card');
            panels.forEach((panel) => {
                gsap.fromTo(panel,
                    { y: 150, opacity: 0, rotationX: 10 },
                    {
                        scrollTrigger: {
                            trigger: panel,
                            start: "top 85%",
                            end: "top 30%",
                            scrub: 1
                        },
                        y: 0, opacity: 1, rotationX: 0, ease: "none"
                    }
                );
            });

            // Botón Menú también abre sidebar
            const menuBtn = document.getElementById('sidebarToggleMenu');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            const toggleBtn = document.getElementById('sidebarToggle');
            function setSidebar(open) {
                if (!sidebar || !overlay) return;
                sidebar.classList.toggle('sidebar--open', open);
                overlay.classList.toggle('overlay--show', open);
                sidebar.setAttribute('aria-hidden', !open);
                if (toggleBtn) toggleBtn.setAttribute('aria-expanded', open);
                document.body.classList.toggle('no-scroll', open);
            }
            if (menuBtn) {
                menuBtn.addEventListener('click', () => {
                    const isOpen = sidebar.classList.contains('sidebar--open');
                    setSidebar(!isOpen);
                });
            }
        });
    </script>
</body>
</html>
